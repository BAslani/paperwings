  nights:
  - title: Trespasser
    memo: 'MEMO from Marketing: Welcome to the night shift, rookie. An Accounting
      plane (red trail) is snooping round the office. It keeps coming back, so shoot
      it down twice. New here? Fly FLIGHT SCHOOL from the main menu first. Their
      pilots climb in warm air to recover: the radiators under the windows are where
      they''ll go.'
    mode: 2
    room: 0
    place: 'Office: the coworker''s corner'
    area: 
    spawn: CoworkerSpawn
    objective: 0
    group: 
    allowedLosses: 2
    aceName: 
    killTarget: 2
    maxRivals: 1
    timeLimit: 0
    airTimeTarget: 0
    windScale: 1
    noPencils: 0
    rivalPilot: {fileID: 0}
    twoStarTime: 60
    threeStarTime: 35
    rewardClips: 60
    rewardUnlockId: 
  - title: Paper Trail
    memo: 'MEMO: Accounting couriers are carrying our campaign plans along the window
      row to the door. Shoot down four before three get out. They always fly the
      same line, and one rival flies cover. Ride the radiators to stay above them.'
    mode: 2
    room: 0
    place: 'Office: the window row'
    area: 
