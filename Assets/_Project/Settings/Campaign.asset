  nights:
  - title: Target Practice
    memo: 'MEMO from Marketing: Welcome to the night shift, rookie. Hold Throw to
      wind up, let go to fly, hold Fire for staples. Six practice drones are circling
      the office. The space heater by the couch throws up warm air (orange): circle
      in it to climb.'
    mode: 2
    room: 0
    place: 'Office: the lounge'
    area: 
    spawn: LoungeSpawn
    objective: 3
    group: PracticeDrones
    allowedLosses: 2
    aceName: 
    killTarget: 6
    maxRivals: -1
    timeLimit: 0
    airTimeTarget: 0
    windScale: 1
    noPencils: 0
    twoStarTime: 75
    threeStarTime: 50
    rewardClips: 40
    rewardUnlockId: 
  - title: Trespasser
    memo: 'MEMO: An Accounting plane (red trail) is snooping round the office. It
      keeps coming back, so shoot it down twice. Their pilots climb in warm air to
      recover: the radiators under the windows are where they''ll go.'
    mode: 2
    room: 0
    place: 'Office: the coworker''s corner'
    area: 
