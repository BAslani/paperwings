  starBonus: 0f0000001e000000
  nights:
  - title: First Flight
    memo: 'MEMO from Marketing: Welcome to the night shift, rookie. Hold Throw to
      wind up, let go to fly. Dive for speed, climb to slow down, ride the laptop''s
      heat. Stay up for fifteen seconds in one flight.'
    mode: 0
    room: 0
    killTarget: 0
    maxRivals: 0
    timeLimit: 0
    airTimeTarget: 15
    windScale: 1
    noPencils: 0
    twoStarTime: 25
    threeStarTime: 16
    rewardClips: 30
    rewardUnlockId: 
  - title: The Ring Route
    memo: 'MEMO: The sticky-note rings mark our patrol route. Ride the laptop''s
      heat to climb, boost when you need speed, and thread every ring.'
    mode: 1
    room: 0
    killTarget: 0
    maxRivals: 0
    timeLimit: 0
    airTimeTarget: 0
    windScale: 1
    noPencils: 0
    twoStarTime: 55
    threeStarTime: 40
    rewardClips: 40
    rewardUnlockId: 
  - title: Trespasser
    memo: 'MEMO: One of Accounting''s planes is snooping round our desks. It keeps
      coming back for more, so shoot it down twice. Supply is sending your Dart a
      bigger staple magazine.'
    mode: 2
    room: 0
    killTarget: 2
    maxRivals: 1
    timeLimit: 0
    airTimeTarget: 0
    windScale: 1
    noPencils: 0
    twoStarTime: 60
    threeStarTime: 35
    rewardClips: 20
    rewardUnlockId: dart:staples_plus
  - title: Rough Air
    memo: 'MEMO: Someone set every fan and vent to MAX. Fly the ring route anyway.
      The air pushes harder tonight, so use it, don''t fight it.'
    mode: 1
    room: 0
    killTarget: 0
    maxRivals: 0
    timeLimit: 120
    airTimeTarget: 0
    windScale: 1.6
    noPencils: 0
    twoStarTime: 70
    threeStarTime: 50
    rewardClips: 50
    rewardUnlockId: 
  - title: Pencil Pushers
    memo: 'MEMO: Accounting is out in force. Down four of them and we''ll requisition
      you a pair of lock-on pencil missiles for your Dart.'
    mode: 2
    room: 0
    killTarget: 4
    maxRivals: 0
    timeLimit: 0
    airTimeTarget: 0
    windScale: 1
    noPencils: 0
    twoStarTime: 110
    threeStarTime: 75
    rewardClips: 20
    rewardUnlockId: dart:pencils
  - title: Against the Clock
    memo: 'MEMO: The cleaners come at dawn. Run the whole route in under a minute.
      Do it and R&D will teach you the Glider fold.'
    mode: 1
    room: 0
    killTarget: 0
    maxRivals: 0
    timeLimit: 60
    airTimeTarget: 0
    windScale: 1
    noPencils: 0
    twoStarTime: 42
    threeStarTime: 32
    rewardClips: 30
    rewardUnlockId: fold_glider
  - title: Backup
    memo: 'MEMO: You''re not alone any more. Two Marketing wingmen fly with you tonight.
      Together, down six of Accounting''s planes.'
    mode: 4
    room: 0
    killTarget: 6
    maxRivals: 0
    timeLimit: 0
    airTimeTarget: 0
    windScale: 1
    noPencils: 0
    twoStarTime: 130
    threeStarTime: 90
    rewardClips: 60
    rewardUnlockId: 
  - title: Staples Only
    memo: 'MEMO: Pencil audit tonight, so they stay in the drawer. Five kills with
      staples alone, before the clock runs out. Survive it and your Dart gets heavy
      paper.'
    mode: 2
    room: 0
    killTarget: 5
    maxRivals: 0
